PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/invoizmo
JWT_ACCESS_SECRET=your_access_secret_here_must_be_long
JWT_REFRESH_SECRET=your_refresh_secret_here_must_be_long
